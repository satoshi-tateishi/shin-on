APP_NAME="shin·on dB"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN_HERE
APP_PORT=80
VITE_PORT=5174

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=YOUR_DB_USERNAME_HERE
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=YOUR_DOMAIN_HERE
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=YOUR_SMTP_HOST_HERE
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME_HERE
MAIL_PASSWORD=YOUR_SMTP_PASSWORD_HERE
MAIL_FROM_ADDRESS="noreply@YOUR_DOMAIN_HERE"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LINE WORKS OAuth Settings
LINEWORKS_CLIENT_ID=YOUR_CLIENT_ID_HERE
LINEWORKS_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
LINEWORKS_REDIRECT_URI="${APP_URL}/auth/lineworks/callback"
LINEWORKS_DOMAIN=shin-on1981

# LINE WORKS BOT API Settings (2FA二段階認証用)
LINEWORKS_API_BASE_URL=https://www.worksapis.com/v1.0
LINEWORKS_AUTH_URL=https://auth.worksmobile.com/oauth2/v2.0/token
LINEWORKS_BOT_ID=YOUR_BOT_ID_HERE
LINEWORKS_BOT_SECRET=YOUR_BOT_SECRET_HERE
LINEWORKS_DB_CLIENT_ID=YOUR_DB_CLIENT_ID_HERE
LINEWORKS_DB_CLIENT_SECRET=YOUR_DB_CLIENT_SECRET_HERE
LINEWORKS_SERVICE_ACCOUNT=YOUR_SERVICE_ACCOUNT_HERE
LINEWORKS_PRIVATE_KEY_PATH=lineworks/private_key.pem

# LINE WORKS Notification Settings
LINEWORKS_EQUIPMENT_CHANNEL=
LINEWORKS_PHASE_CHANNEL=
LINEWORKS_FILE_MAX_SIZE=10485760

# Dropbox OAuth 2.0設定（リフレッシュトークン対応）
DROPBOX_CLIENT_ID=YOUR_DROPBOX_CLIENT_ID_HERE
DROPBOX_CLIENT_SECRET=YOUR_DROPBOX_CLIENT_SECRET_HERE
DROPBOX_REDIRECT_URI="${APP_URL}/auth/dropbox/callback"

# Dropboxバックアップ設定
DROPBOX_ACCESS_TOKEN_LIFETIME=14400
BACKUP_TIMEZONE=Asia/Tokyo
BACKUP_RETENTION_DAYS=30

# 従来のアクセストークン（フォールバック用）
DROPBOX_ACCESS_TOKEN=YOUR_DROPBOX_ACCESS_TOKEN_HERE
